class Solution {
    public int networkDelayTime(int[][] times, int n, int k) {
      ArrayList<ArrayList<int[]>>adj=new ArrayList<>();
      for(int i=0; i<=n; i++)
      {
        adj.add(new ArrayList<>());
      }
      for(int[] time:times)
      {
        int u=time[0];
        int v=time[1];
        int w=time[2];
        adj.get(u).add(new int[]{v, w});
      } 
      int[] res=new int[n+1];
      Arrays.fill(res, (int)1e9);
      res[k]=0;
      int[] vis=new int[n+1];
      Arrays.fill(vis, 0);

      PriorityQueue<int[]>pq=new PriorityQueue<>((a,b)->Integer.compare(a[1], b[1])); 

      pq.add(new int[]{k, 0});
      while(!pq.isEmpty())
      {
        int[] curr=pq.poll();
        int node=curr[0];
        int w=curr[1];

        if(vis[node]==1)
        {
            continue;
        }
        vis[node]=1;

        for(int[] it:adj.get(node))
        {
            int adjnode=it[0];
            int adjwt=it[1];
            int newwt=w+adjwt;
            if(vis[adjnode]==0 && newwt<res[adjnode])
            {
                res[adjnode]=newwt;
                pq.add(new int[]{adjnode, res[adjnode]});
            }
        }
      }
      int ans=0;
      for(int i=1; i<=n; i++)
      {
        // if(res[i]==(int)1e9)
        // {
        //     return -1;
        // }
        ans=Math.max(ans,res[i]);
      }
      if(ans==(int)1e9)return -1;  
      return ans;
    }
}
